# Copy to .env.evolution (ignored by Git). Generate each secret with openssl rand -hex 32.
# Use hex for the database password so it is safe in the connection URI.
EVOLUTION_API_KEY=
EVOLUTION_DB_PASSWORD=
EVOLUTION_PORT=8081
# Callback address reachable FROM Chatwoot; default works when Compose files are merged.
EVOLUTION_SERVER_URL=http://evolution-api:8080
